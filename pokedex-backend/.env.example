# Bắt buộc. Chuỗi ngẫu nhiên riêng, tối thiểu 32 ký tự. Không commit giá trị thật.
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Bắt buộc để Prisma kết nối. Dùng placeholder khi chỉ build/test.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/pokedex?schema=public"

# Tuỳ chọn. Danh sách origin được phép gọi API (phân cách bằng dấu phẩy).
# Mặc định chỉ cho phép localhost:5173 / 127.0.0.1:5173.
CORS_ORIGIN="https://your-frontend.example.com"

# Tuỳ chọn. Tài khoản hiện có được phép dùng CMS/sync (phân cách bằng dấu phẩy).
# Không có giá trị nào thì mọi mutation admin bị từ chối.
ADMIN_USERNAMES="admin-username"
ADMIN_EMAILS="admin@example.com"

PORT=3000
NODE_ENV=production
