{
  "name": "pokedex-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "seed": "tsx scripts/seed.ts",
    "seed:walkthrough": "tsx scripts/seed-walkthrough.ts",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "make-admin": "tsx scripts/make-admin.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express4": "^1.1.2",
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "graphql": "^16.13.2",
    "jsonwebtoken": "^9.0.3",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "prisma": "^5.20.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
