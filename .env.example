# Copy the relevant section into pokedex-backend/.env and pokedex-frontend/.env

# ── Backend (pokedex-backend/.env) ───────────────────────────
# PostgreSQL connection string (local docker-compose or Neon)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/pokedex"
# Required. Random string, at least 32 chars. Generate with: openssl rand -hex 32
JWT_SECRET=""
# Comma-separated list of allowed frontend origins
CORS_ORIGINS="http://localhost:5173"
# Optional
PORT=3000
# Set to 1 when running behind one reverse proxy (Render, Nginx...) so rate limiting sees real client IPs
TRUST_PROXY=
# "production" disables GraphQL introspection
NODE_ENV=development

# ── Frontend (pokedex-frontend/.env) ─────────────────────────
# Backend GraphQL URL. Leave empty in local dev to use the Vite proxy (/graphql -> localhost:3000)
VITE_GRAPHQL_API_URL=
